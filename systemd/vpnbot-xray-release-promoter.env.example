VPNBOT_XRAY_FORGEJO_RELEASES_URL=https://git.zapret.moe/api/v1/repos/zapretkvn/vpnbot-xray-patches/releases
VPNBOT_XRAY_FORGEJO_TOKEN_FILE=/home/codex-pve/vpnbot/vpnbotdata/env/vpnbot_xray_release_promoter.token
# The canary must reach the production host both ways: the promoter SSHes to
# it, and its updater downloads the candidate and the rollback release from
# Forgejo on this host.  27.09.2026 magnus lost both directions (a jump could
# reach it, but its updater could not fetch any release), so the canary moved
# to tinl3 — a direct route, GOAMD64=v3 CPU flags, the hub's pinned host key.
VPNBOT_XRAY_CANARY_NODE=tinl3
VPNBOT_XRAY_CANARY_HOST=72.56.91.128
VPNBOT_XRAY_CANARY_SSH_PORT=10222
VPNBOT_XRAY_CANARY_SSH_USER=root
VPNBOT_XRAY_CANARY_IDENTITY_FILE=/root/.ssh/id_ed25519
VPNBOT_XRAY_CANARY_KNOWN_HOSTS_FILE=/var/lib/vpnbot-node-manager/bootstrap/tinl3/known_hosts
# Optional SSH jump to the canary, the hub's own control-plane bridge route
# (inventory routes of the canary node, kind=jump).  All four together or none;
# the jump host must be pinned in the same known_hosts file.  A jump fixes only
# the promoter's SSH path, never the canary's own download path.
#VPNBOT_XRAY_CANARY_JUMP_HOST=148.135.184.185
#VPNBOT_XRAY_CANARY_JUMP_PORT=10222
#VPNBOT_XRAY_CANARY_JUMP_USER=vpnbot-bridge
#VPNBOT_XRAY_CANARY_JUMP_IDENTITY_FILE=/root/.ssh/projects/vpnbot/control-plane-bridges/honkey/id_ed25519
VPNBOT_XRAY_CANARY_UPDATER=/usr/local/bin/vpnbot-xray-core-updater
VPNBOT_XRAY_PROMOTER_STATE_DIR=/var/lib/vpnbot-xray-release-promoter
