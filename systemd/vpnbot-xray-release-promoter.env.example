VPNBOT_XRAY_FORGEJO_RELEASES_URL=https://git.zapret.moe/api/v1/repos/zapretkvn/vpnbot-xray-patches/releases
VPNBOT_XRAY_FORGEJO_TOKEN_FILE=/home/codex-pve/vpnbot/vpnbotdata/env/vpnbot_xray_release_promoter.token
# The canary is not configured here.  The hub marks it in its registry
# (label xray-canary, vpnbot_node_manager/xray_canary.py) and moves the mark
# itself when the node is deleted, retired, deaf or handed back for a CPU that
# cannot run the GOAMD64 v3 build; the promoter asks
# /opt/vpnbot-node-manager/scripts/manage_node.py xray-canary on every run.
# Until 15.11.2026 the node was written here by hand, and the deleted tinl3
# failed every run from 14.11.
VPNBOT_XRAY_CANARY_UPDATER=/usr/local/bin/vpnbot-xray-core-updater
VPNBOT_XRAY_PROMOTER_STATE_DIR=/var/lib/vpnbot-xray-release-promoter
