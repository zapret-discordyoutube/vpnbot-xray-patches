 // RemoveUser implements proxy.UserManager.RemoveUser().
 func (h *Handler) RemoveUser(ctx context.Context, e string) error {
-	h.RemoveReverse(h.validator.GetByEmail(e))
-	return h.validator.Del(e)
+	email := strings.ToLower(strings.TrimSpace(e))
+	h.activeSessionsMu.Lock()
+	user := h.validator.GetByEmail(email)
+	var err error
+	if user != nil {
+		err = h.validator.Del(email)
+	}
+	sessions := h.activeSessionsForEmailLocked(email)
+	h.activeSessionsMu.Unlock()
+
+	h.RemoveReverse(user)
+	for _, connection := range sessions {
+		if closeErr := common.Interrupt(connection); closeErr != nil && err == nil {
+			err = errors.New("failed to interrupt active VLESS user session").Base(closeErr)
+		}
+	}
+	return err
+}
+
+func (h *Handler) registerActiveSession(user *protocol.MemoryUser, connection common.Closable) (func(), error) {
+	if user == nil || user.Account == nil || connection == nil {
+		return func() {}, nil
+	}
+	email := strings.ToLower(strings.TrimSpace(user.Email))
+	if email == "" {
+		return func() {}, nil
+	}
+
+	h.activeSessionsMu.Lock()
+	if h.activeSessionsClosed {
+		h.activeSessionsMu.Unlock()
+		return nil, errors.New("VLESS inbound is closed").AtInfo()
+	}
+	current := h.validator.GetByEmail(email)
+	if current == nil || current.Account == nil || !current.Account.Equals(user.Account) {
+		h.activeSessionsMu.Unlock()
+		return nil, errors.New("VLESS user was removed while the connection was authenticating").AtInfo()
+	}
+	if h.activeSessions == nil {
+		h.activeSessions = make(map[string]map[uint64]common.Closable)
+	}
+	byID := h.activeSessions[email]
+	if byID == nil {
+		byID = make(map[uint64]common.Closable)
+		h.activeSessions[email] = byID
+	}
+	h.nextActiveSessionID++
+	sessionID := h.nextActiveSessionID
+	byID[sessionID] = connection
+	h.activeSessionsMu.Unlock()
+
+	return func() {
+		h.activeSessionsMu.Lock()
+		if currentByID := h.activeSessions[email]; currentByID != nil {
+			delete(currentByID, sessionID)
+			if len(currentByID) == 0 {
+				delete(h.activeSessions, email)
+			}
+		}
+		h.activeSessionsMu.Unlock()
+	}, nil
+}
+
+func (h *Handler) activeSessionsForEmailLocked(email string) []common.Closable {
+	byID := h.activeSessions[email]
+	if len(byID) == 0 {
+		return nil
+	}
+	sessions := make([]common.Closable, 0, len(byID))
+	for _, connection := range byID {
+		sessions = append(sessions, connection)
+	}
+	return sessions
+}
+
+func (h *Handler) takeAllActiveSessions() []common.Closable {
+	h.activeSessionsMu.Lock()
+	defer h.activeSessionsMu.Unlock()
+	var sessions []common.Closable
+	for email := range h.activeSessions {
+		sessions = append(sessions, h.activeSessionsForEmailLocked(email)...)
+	}
+	h.activeSessions = nil
+	h.activeSessionsClosed = true
+	return sessions
 }
 
