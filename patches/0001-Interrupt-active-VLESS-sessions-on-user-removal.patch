+package inbound
+
+import (
+	"context"
+	"io"
+	stdnet "net"
+	"testing"
+
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/uuid"
+	"github.com/xtls/xray-core/proxy/vless"
+)
+
+func testMemoryUser(t *testing.T, email, rawID string) *protocol.MemoryUser {
+	t.Helper()
+	id, err := uuid.ParseString(rawID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &protocol.MemoryUser{
+		Email: email,
+		Account: &vless.MemoryAccount{
+			ID: protocol.NewID(id),
+		},
+	}
+}
+
+func TestRemoveUserInterruptsOnlyItsActiveSessions(t *testing.T) {
+	validator := new(vless.MemoryValidator)
+	userA := testMemoryUser(t, "A@example.com", "11111111-1111-4111-8111-111111111111")
+	userB := testMemoryUser(t, "b@example.com", "22222222-2222-4222-8222-222222222222")
+	if err := validator.Add(userA); err != nil {
+		t.Fatal(err)
+	}
+	if err := validator.Add(userB); err != nil {
+		t.Fatal(err)
+	}
+	handler := &Handler{validator: validator}
+
+	serverA, clientA := stdnet.Pipe()
+	defer clientA.Close()
+	unregisterA, err := handler.registerActiveSession(userA, serverA)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unregisterA()
+
+	serverB, clientB := stdnet.Pipe()
+	defer serverB.Close()
+	defer clientB.Close()
+	go func() {
+		_, _ = io.Copy(io.Discard, serverB)
+	}()
+	unregisterB, err := handler.registerActiveSession(userB, serverB)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unregisterB()
+
+	if err := handler.RemoveUser(context.Background(), "a@EXAMPLE.com"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := clientA.Write([]byte("closed")); err == nil {
+		t.Fatal("removed user's peer remained writable")
+	}
+	if err := handler.RemoveUser(context.Background(), "a@example.com"); err != nil {
+		t.Fatalf("repeated removal must remain idempotent: %v", err)
+	}
+	if _, err := clientB.Write([]byte("still-open")); err != nil {
+		t.Fatalf("another user's session was interrupted: %v", err)
+	}
+}
+
+func TestAuthenticationRaceCannotRegisterRemovedIdentity(t *testing.T) {
+	validator := new(vless.MemoryValidator)
+	oldUser := testMemoryUser(t, "same@example.com", "33333333-3333-4333-8333-333333333333")
+	newUser := testMemoryUser(t, "same@example.com", "44444444-4444-4444-8444-444444444444")
+	if err := validator.Add(oldUser); err != nil {
+		t.Fatal(err)
+	}
+	handler := &Handler{validator: validator}
+	if err := handler.RemoveUser(context.Background(), oldUser.Email); err != nil {
+		t.Fatal(err)
+	}
+	if err := handler.AddUser(context.Background(), newUser); err != nil {
+		t.Fatal(err)
+	}
+
+	oldServer, oldClient := stdnet.Pipe()
+	defer oldServer.Close()
+	defer oldClient.Close()
+	if _, err := handler.registerActiveSession(oldUser, oldServer); err == nil {
+		t.Fatal("a connection authenticated as the removed UUID joined the replacement user's registry")
+	}
+
+	newServer, newClient := stdnet.Pipe()
+	defer newClient.Close()
+	unregister, err := handler.registerActiveSession(newUser, newServer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unregister()
+	if err := handler.RemoveUser(context.Background(), newUser.Email); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := newClient.Write([]byte("closed")); err == nil {
+		t.Fatal("the replacement identity's active session was not interrupted")
+	}
+}
+
+func TestHandlerCloseInterruptsSessionsAndRejectsLateRegistration(t *testing.T) {
+	validator := new(vless.MemoryValidator)
+	user := testMemoryUser(t, "close@example.com", "55555555-5555-4555-8555-555555555555")
+	if err := validator.Add(user); err != nil {
+		t.Fatal(err)
+	}
+	handler := &Handler{validator: validator}
+	server, client := stdnet.Pipe()
+	defer client.Close()
+	unregister, err := handler.registerActiveSession(user, server)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unregister()
+
+	if err := handler.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := client.Write([]byte("closed")); err == nil {
+		t.Fatal("handler close left an active VLESS session writable")
+	}
+
+	lateServer, lateClient := stdnet.Pipe()
+	defer lateServer.Close()
+	defer lateClient.Close()
+	if _, err := handler.registerActiveSession(user, lateServer); err == nil {
+		t.Fatal("closed handler admitted a late active session")
+	}
+	if err := handler.AddUser(context.Background(), user); err == nil {
+		t.Fatal("closed handler admitted a late user")
+	}
+}
