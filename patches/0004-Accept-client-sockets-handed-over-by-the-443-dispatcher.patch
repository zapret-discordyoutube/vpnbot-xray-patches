@@ -0,0 +1,135 @@
+//go:build linux
+
+package tcp_test
+
+import (
+	"context"
+	"io"
+	gonet "net"
+	"strconv"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	. "github.com/xtls/xray-core/transport/internet/tcp"
+)
+
+func freePort(t *testing.T) int {
+	t.Helper()
+	l, err := gonet.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	return l.Addr().(*gonet.TCPAddr).Port
+}
+
+func accepted(t *testing.T, conns chan stat.Connection) stat.Connection {
+	t.Helper()
+	select {
+	case c := <-conns:
+		c.SetDeadline(time.Now().Add(5 * time.Second))
+		return c
+	case <-time.After(5 * time.Second):
+		t.Fatal("the inbound got no connection")
+		return nil
+	}
+}
+
+func readString(t *testing.T, c gonet.Conn, n int) string {
+	t.Helper()
+	got := make([]byte, n)
+	if _, err := io.ReadFull(c, got); err != nil {
+		t.Fatalf("read: %v", err)
+	}
+	return string(got)
+}
+
+// One inbound, two ways in: its TCP listener keeps reading the PROXY header the dispatcher's copy path sends,
+// and a socket handed over beside it reaches the same handler with no header and its real peer.
+func TestAnInboundTakesHandedOverSocketsBesideItsPROXYListener(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv(internet.HandoffDirEnv, dir)
+	port := freePort(t)
+	settings := &internet.MemoryStreamConfig{
+		ProtocolName: "tcp", ProtocolSettings: &Config{},
+		SocketSettings: &internet.SocketConfig{AcceptProxyProtocol: true},
+	}
+	conns := make(chan stat.Connection, 4)
+	l, err := ListenTCP(context.Background(), net.LocalHostIP, net.Port(port), settings, func(c stat.Connection) { conns <- c })
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	viaTCP, err := gonet.Dial("tcp", gonet.JoinHostPort("127.0.0.1", strconv.Itoa(port)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer viaTCP.Close()
+	if _, err := viaTCP.Write([]byte("PROXY TCP4 203.0.113.7 127.0.0.1 40000 443\r\none")); err != nil {
+		t.Fatal(err)
+	}
+	first := accepted(t, conns)
+	if got := readString(t, first, 3); got != "one" {
+		t.Fatalf("via TCP read %q", got)
+	}
+	if first.RemoteAddr().String() != "203.0.113.7:40000" {
+		t.Fatalf("via TCP the peer is %v, want the PROXY header's", first.RemoteAddr())
+	}
+	first.Close()
+
+	client, server := clientPair(t)
+	defer client.Close()
+	if _, err := client.Write([]byte("two")); err != nil {
+		t.Fatal(err)
+	}
+	d, err := gonet.DialUnix("unixpacket", nil, &gonet.UnixAddr{Name: internet.HandoffPath(dir, port), Net: "unixpacket"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	f, _ := server.File()
+	if _, _, err := d.WriteMsgUnix([]byte{0}, syscall.UnixRights(int(f.Fd())), nil); err != nil {
+		t.Fatal(err)
+	}
+	f.Close()
+	server.Close()
+	d.Close()
+	second := accepted(t, conns)
+	if got := readString(t, second, 3); got != "two" {
+		t.Fatalf("handed over read %q", got)
+	}
+	if second.RemoteAddr().String() != client.LocalAddr().String() {
+		t.Fatalf("handed over the peer is %v, want the client %v", second.RemoteAddr(), client.LocalAddr())
+	}
+	second.Close()
+
+	if err := l.Close(); err != nil {
+		t.Fatal(err)
+	}
+	again, err := internet.ListenHandoffBeside(&gonet.TCPAddr{IP: gonet.IPv4(127, 0, 0, 1), Port: port})
+	if err != nil || again == nil {
+		t.Fatalf("Close kept the handoff path: %v", err)
+	}
+	again.Close()
+}
+
+func clientPair(t *testing.T) (gonet.Conn, *gonet.TCPConn) {
+	t.Helper()
+	l, err := gonet.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	client, err := gonet.Dial("tcp", l.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	s, err := l.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return client, s.(*gonet.TCPConn)
+}
