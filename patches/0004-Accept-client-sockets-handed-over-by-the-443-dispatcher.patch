+//go:build !linux
+
+package internet
+
+import (
+	"net"
+	"os"
+	"strings"
+
+	"github.com/xtls/xray-core/common/errors"
+)
+
+// HandoffSuffix marks a unix listen path that receives TCP sockets handed over by a dispatcher (Linux only).
+const HandoffSuffix = ".handoff"
+
+func isHandoffPath(address string) bool { return strings.HasSuffix(address, HandoffSuffix) }
+
+func listenHandoff(address string, perm *os.FileMode, locker *FileLocker) (net.Listener, error) {
+	return nil, errors.New("handoff listeners need Linux: ", address)
+}
diff --git a/transport/internet/system_listener.go b/transport/internet/system_listener.go
index b651796..ee1c320 100644
--- a/transport/internet/system_listener.go
+++ b/transport/internet/system_listener.go
@@ -145,6 +145,19 @@ func (dl *DefaultListener) Listen(ctx context.Context, addr net.Addr, sockopt *S
 			if err := locker.Acquire(); err != nil {
 				return nil, err
 			}
+			if isHandoffPath(address) {
+				// The clients are handed-over TCP sockets with the real peer: there is no proxy, so a PROXY
+				// header would never come; refuse the combination rather than wait for it on every connection.
+				if sockopt != nil && sockopt.AcceptProxyProtocol {
+					locker.Release()
+					return nil, errors.New("a handoff listener cannot accept the PROXY protocol: ", address)
+				}
+				l, err = listenHandoff(address, filePerm, locker)
+				if err != nil {
+					locker.Release()
+				}
+				return l, err
+			}
 
 			// set callback to combine listener and set permission
 			callback = func(l net.Listener, err error) (net.Listener, error) {
