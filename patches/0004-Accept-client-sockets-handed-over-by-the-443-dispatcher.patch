diff --git a/transport/internet/handoff_beside.go b/transport/internet/handoff_beside.go
new file mode 100644
index 0000000..8917105
--- /dev/null
+++ b/transport/internet/handoff_beside.go
@@ -0,0 +1,93 @@
+package internet
+
+import (
+	"context"
+	goerrors "errors"
+	"net"
+	"sync"
+
+	"github.com/xtls/xray-core/common/errors"
+)
+
+// ListenBeside returns the stream listener every TCP-based transport hub serves (raw, WebSocket, HTTPUpgrade,
+// gRPC, XHTTP): l itself when no sockets are handed over beside it (see ListenHandoffBeside), or a listener that
+// accepts from both l and <dir>/<port>.handoff. The hub wraps the result exactly as it wraps l (TLS, REALITY,
+// HTTP, gRPC), so a handed-over client meets the same inbound; it never passes l's own wrappers, such as the
+// PROXY reader, because no proxy stands in front of it. On an error l is closed.
+func ListenBeside(ctx context.Context, l net.Listener, addr net.Addr) (net.Listener, error) {
+	tcpAddr, isTCP := addr.(*net.TCPAddr)
+	if !isTCP {
+		return l, nil
+	}
+	handoff, err := ListenHandoffBeside(tcpAddr)
+	if err != nil {
+		l.Close()
+		return nil, errors.New("failed to take handed-over sockets beside ", addr).Base(err)
+	}
+	if handoff == nil {
+		return l, nil
+	}
+	errors.LogInfo(ctx, "taking handed-over sockets on ", handoff.Addr(), " beside ", addr)
+	return newBesideListener(l, handoff), nil
+}
+
+type acceptResult struct {
+	conn net.Conn
+	err  error
+}
+
+// besideListener accepts from two listeners. Addr is the configured listener's; Close ends both.
+type besideListener struct {
+	net.Listener
+	handoff  net.Listener
+	accepted chan acceptResult // unbuffered: a connection is accepted from a side only when the hub asks
+	done     chan struct{}
+	once     sync.Once
+}
+
+func newBesideListener(l, handoff net.Listener) *besideListener {
+	b := &besideListener{Listener: l, handoff: handoff, accepted: make(chan acceptResult), done: make(chan struct{})}
+	go b.pump(l)
+	go b.pump(handoff)
+	return b
+}
+
+// pump hands what one side accepts to Accept, errors included, so the hub's loop judges them as it judges a
+// plain listener's; it stops once its side is closed.
+func (b *besideListener) pump(l net.Listener) {
+	for {
+		conn, err := l.Accept()
+		select {
+		case b.accepted <- acceptResult{conn, err}:
+		case <-b.done:
+			if conn != nil {
+				conn.Close()
+			}
+			return
+		}
+		if err != nil && goerrors.Is(err, net.ErrClosed) {
+			return
+		}
+	}
+}
+
+func (b *besideListener) Accept() (net.Conn, error) {
+	select {
+	case r := <-b.accepted:
+		return r.conn, r.err
+	case <-b.done:
+		return nil, net.ErrClosed // "use of closed network connection": the hubs stop accepting on it
+	}
+}
+
+func (b *besideListener) Close() error {
+	err := net.ErrClosed
+	b.once.Do(func() {
+		close(b.done)
+		err = b.Listener.Close()
+		if herr := b.handoff.Close(); err == nil {
+			err = herr
+		}
+	})
+	return err
+}
diff --git a/transport/internet/handoff_beside_linux_test.go b/transport/internet/handoff_beside_linux_test.go
new file mode 100644
index 0000000..c413368
--- /dev/null
+++ b/transport/internet/handoff_beside_linux_test.go
@@ -0,0 +1,114 @@
+//go:build linux
+
+package internet_test
+
+import (
+	"context"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+// Without the node's directory a hub serves its configured listener itself: nothing is wrapped.
+func TestListenBesideIsTheListenerItselfWhenNothingIsHandedOver(t *testing.T) {
+	t.Setenv(internet.HandoffDirEnv, "")
+	tcp, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tcp.Close()
+	got, err := internet.ListenBeside(context.Background(), tcp, tcp.Addr())
+	if err != nil || got != tcp {
+		t.Fatalf("ListenBeside = %v, %v; want the listener itself", got, err)
+	}
+	unixAddr := &net.UnixAddr{Name: "@x", Net: "unix"}
+	t.Setenv(internet.HandoffDirEnv, t.TempDir())
+	if got, err := internet.ListenBeside(context.Background(), tcp, unixAddr); err != nil || got != tcp {
+		t.Fatalf("a non-TCP address was wrapped: %v, %v", got, err)
+	}
+}
+
+func acceptOne(t *testing.T, l net.Listener) net.Conn {
+	t.Helper()
+	type res struct {
+		c   net.Conn
+		err error
+	}
+	ch := make(chan res, 1)
+	go func() { c, err := l.Accept(); ch <- res{c, err} }()
+	select {
+	case r := <-ch:
+		if r.err != nil {
+			t.Fatalf("accept: %v", r.err)
+		}
+		r.c.SetDeadline(time.Now().Add(5 * time.Second))
+		return r.c
+	case <-time.After(5 * time.Second):
+		t.Fatal("nothing accepted")
+		return nil
+	}
+}
+
+// One listener, both ways in: a TCP client of the configured listener and a socket handed over beside it are
+// accepted from the same Accept, Addr stays the configured one, and Close ends both and frees the path.
+func TestABesideListenerAcceptsFromBothAndCloseEndsBoth(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv(internet.HandoffDirEnv, dir)
+	tcp, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	addr := tcp.Addr().(*net.TCPAddr)
+	l, err := internet.ListenBeside(context.Background(), tcp, addr)
+	if err != nil || l == tcp {
+		t.Fatalf("ListenBeside = %v, %v; want a listener beside", l, err)
+	}
+	if l.Addr().String() != addr.String() {
+		t.Fatalf("Addr %v, want the configured %v", l.Addr(), addr)
+	}
+
+	viaTCP, err := net.Dial("tcp", addr.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer viaTCP.Close()
+	viaTCP.Write([]byte("one"))
+	first := acceptOne(t, l)
+	got := make([]byte, 3)
+	if _, err := io.ReadFull(first, got); err != nil || string(got) != "one" {
+		t.Fatalf("via TCP read %q: %v", got, err)
+	}
+	first.Close()
+
+	client, server := tcpPair(t)
+	defer client.Close()
+	client.Write([]byte("two"))
+	handOver(t, internet.HandoffPath(dir, addr.Port), server)
+	second := acceptOne(t, l)
+	if _, err := io.ReadFull(second, got); err != nil || string(got) != "two" {
+		t.Fatalf("handed over read %q: %v", got, err)
+	}
+	if second.RemoteAddr().String() != client.LocalAddr().String() {
+		t.Fatalf("handed over the peer is %v, want %v", second.RemoteAddr(), client.LocalAddr())
+	}
+	second.Close()
+
+	if err := l.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := l.Accept(); err == nil {
+		t.Fatal("Accept after Close returned a connection")
+	}
+	if c, err := net.Dial("tcp", addr.String()); err == nil {
+		c.Close()
+		t.Fatal("the configured listener still accepts after Close")
+	}
+	again, err := internet.ListenHandoffBeside(addr)
+	if err != nil || again == nil {
+		t.Fatalf("Close kept the handoff path: %v", err)
+	}
+	again.Close()
+}
diff --git a/transport/internet/handoff_listener_linux.go b/transport/internet/handoff_listener_linux.go
new file mode 100644
index 0000000..6ba8b39
--- /dev/null
+++ b/transport/internet/handoff_listener_linux.go
@@ -0,0 +1,217 @@
+//go:build linux
+
+package internet
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"sync"
+	"syscall"
+
+	"github.com/xtls/xray-core/common/errors"
+)
+
+// HandoffDirEnv names the directory where every TCP-based inbound (raw, WebSocket, HTTPUpgrade, gRPC, XHTTP;
+// see ListenBeside) listening on an IPv4 loopback address also takes client sockets handed over by the node's
+// 443 dispatcher: <dir>/<port>.handoff, a SOCK_SEQPACKET socket whose messages carry the client socket itself
+// (SCM_RIGHTS). The dispatcher peeks the ClientHello (nothing is consumed) and picks the inbound by its SNI, so
+// the inbound reads the untouched ClientHello, RemoteAddr is the real client, and no proxy sits in the data
+// path. The TCP listener stays exactly as configured, so local probes and the dispatcher's copy path keep
+// reaching the inbound there; unset, nothing changes.
+const HandoffDirEnv = "XRAY_VPNBOT_HANDOFF_DIR"
+
+// HandoffSuffix ends every handoff path.
+const HandoffSuffix = ".handoff"
+
+// HandoffPath is where the inbound listening on 127.0.0.1:port takes handed-over sockets.
+func HandoffPath(dir string, port int) string {
+	return filepath.Join(dir, fmt.Sprintf("%d%s", port, HandoffSuffix))
+}
+
+// ListenHandoffBeside opens the handoff listener of a TCP listener on addr, or returns nil when there is none:
+// the directory is not set, or addr is not an IPv4 loopback address with a port. Handed-over sockets never
+// pass the TCP listener's PROXY wrapper: there is no proxy in front of them, so there is no header.
+func ListenHandoffBeside(addr *net.TCPAddr) (net.Listener, error) {
+	dir := os.Getenv(HandoffDirEnv)
+	if dir == "" || addr == nil || addr.Port == 0 || addr.IP.To4() == nil || !addr.IP.IsLoopback() {
+		return nil, nil
+	}
+	path := HandoffPath(dir, addr.Port)
+	locker := &FileLocker{path: path + ".lock"}
+	if err := locker.Acquire(); err != nil {
+		return nil, err
+	}
+	l, err := listenHandoff(path, locker)
+	if err != nil {
+		locker.Release()
+		return nil, err
+	}
+	return l, nil
+}
+
+// handoffBacklog bounds the sockets received but not yet accepted. When it is full the reader stops
+// reading, the dispatcher's sends block, and the dispatcher queues: backpressure end to end.
+const handoffBacklog = 64
+
+// handoffMaxRights is how many descriptors one message may carry; the dispatcher sends one.
+const handoffMaxRights = 16
+
+type handoffListener struct {
+	unix   *net.UnixListener
+	locker *FileLocker
+	conns  chan net.Conn
+	done   chan struct{}
+	once   sync.Once
+	mu     sync.Mutex
+	peers  map[*net.UnixConn]struct{}
+}
+
+func listenHandoff(address string, locker *FileLocker) (*handoffListener, error) {
+	// The lock is held, so a socket file left at the path belongs to no running listener.
+	if err := os.Remove(address); err != nil && !os.IsNotExist(err) {
+		return nil, errors.New("failed to remove the stale handoff socket ", address).Base(err)
+	}
+	unix, err := net.ListenUnix("unixpacket", &net.UnixAddr{Name: address, Net: "unixpacket"})
+	if err != nil {
+		return nil, err
+	}
+	l := &handoffListener{
+		unix:   unix,
+		locker: locker,
+		conns:  make(chan net.Conn, handoffBacklog),
+		done:   make(chan struct{}),
+		peers:  map[*net.UnixConn]struct{}{},
+	}
+	go l.acceptDispatchers()
+	return l, nil
+}
+
+func (l *handoffListener) acceptDispatchers() {
+	for {
+		peer, err := l.unix.AcceptUnix()
+		if err != nil {
+			return // closed
+		}
+		l.mu.Lock()
+		select {
+		case <-l.done:
+			l.mu.Unlock()
+			peer.Close()
+			return
+		default:
+		}
+		l.peers[peer] = struct{}{}
+		l.mu.Unlock()
+		go l.receive(peer)
+	}
+}
+
+// receive reads handed-over sockets from one dispatcher connection until it closes.
+func (l *handoffListener) receive(peer *net.UnixConn) {
+	defer func() {
+		l.mu.Lock()
+		delete(l.peers, peer)
+		l.mu.Unlock()
+		peer.Close()
+	}()
+	payload := make([]byte, 1)
+	oob := make([]byte, syscall.CmsgSpace(handoffMaxRights*4))
+	for {
+		_, oobn, flags, _, err := peer.ReadMsgUnix(payload, oob)
+		if err != nil {
+			return
+		}
+		fds := handoffRights(oob[:oobn])
+		if flags&syscall.MSG_CTRUNC != 0 {
+			// Descriptors beyond the buffer were closed by the kernel; the ones received are still ours.
+			errors.LogWarning(context.Background(), "handoff: control message truncated")
+		}
+		for _, fd := range fds {
+			conn, ok := handoffConn(fd)
+			if !ok {
+				continue
+			}
+			select {
+			case l.conns <- conn:
+			case <-l.done:
+				conn.Close()
+				for _, rest := range fds {
+					if rest > fd {
+						syscall.Close(rest)
+					}
+				}
+				return
+			}
+		}
+	}
+}
+
+func handoffRights(oob []byte) []int {
+	msgs, err := syscall.ParseSocketControlMessage(oob)
+	if err != nil {
+		return nil
+	}
+	var fds []int
+	for i := range msgs {
+		if rights, err := syscall.ParseUnixRights(&msgs[i]); err == nil {
+			fds = append(fds, rights...)
+		}
+	}
+	return fds
+}
+
+// handoffConn turns a received descriptor into a connection; anything but a TCP stream socket is closed.
+func handoffConn(fd int) (net.Conn, bool) {
+	syscall.CloseOnExec(fd)
+	file := os.NewFile(uintptr(fd), "handoff")
+	conn, err := net.FileConn(file) // dup: the connection owns its own descriptor
+	file.Close()
+	if err != nil {
+		return nil, false
+	}
+	if _, isTCP := conn.(*net.TCPConn); !isTCP {
+		conn.Close()
+		return nil, false
+	}
+	return conn, true
+}
+
+func (l *handoffListener) Accept() (net.Conn, error) {
+	select {
+	case conn := <-l.conns:
+		return conn, nil
+	case <-l.done:
+		return nil, net.ErrClosed // "use of closed network connection": the hub's accept loop stops on it
+	}
+}
+
+func (l *handoffListener) Close() error {
+	var err error
+	l.once.Do(func() {
+		close(l.done)
+		err = l.unix.Close()
+		l.mu.Lock()
+		for peer := range l.peers {
+			peer.Close()
+		}
+		l.mu.Unlock()
+	drain:
+		for {
+			select {
+			case conn := <-l.conns:
+				conn.Close()
+			default:
+				break drain
+			}
+		}
+		if l.locker != nil {
+			l.locker.Release()
+		}
+	})
+	return err
+}
+
+func (l *handoffListener) Addr() net.Addr { return l.unix.Addr() }
diff --git a/transport/internet/handoff_listener_linux_test.go b/transport/internet/handoff_listener_linux_test.go
new file mode 100644
index 0000000..2275f9b
--- /dev/null
+++ b/transport/internet/handoff_listener_linux_test.go
@@ -0,0 +1,214 @@
+//go:build linux
+
+package internet_test
+
+import (
+	"errors"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+// handOver plays the dispatcher: it accepts one TCP client and passes the socket over the handoff path.
+func handOver(t *testing.T, path string, server *net.TCPConn) {
+	t.Helper()
+	d, err := net.DialUnix("unixpacket", nil, &net.UnixAddr{Name: path, Net: "unixpacket"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer d.Close()
+	f, err := server.File()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if _, _, err := d.WriteMsgUnix([]byte{0}, syscall.UnixRights(int(f.Fd())), nil); err != nil {
+		t.Fatal(err)
+	}
+	server.Close() // the dispatcher keeps nothing
+}
+
+func tcpPair(t *testing.T) (client net.Conn, server *net.TCPConn) {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	client, err = net.Dial("tcp", l.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	s, err := l.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return client, s.(*net.TCPConn)
+}
+
+// listen opens the handoff listener beside an inbound on 127.0.0.1:port, with the node's directory set.
+func listen(t *testing.T) (net.Listener, string) {
+	t.Helper()
+	dir := t.TempDir()
+	t.Setenv(internet.HandoffDirEnv, dir)
+	addr := &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 20443}
+	l, err := internet.ListenHandoffBeside(addr)
+	if err != nil || l == nil {
+		t.Fatalf("ListenHandoffBeside = %v, %v", l, err)
+	}
+	t.Cleanup(func() { l.Close() })
+	path := internet.HandoffPath(dir, addr.Port)
+	if path != filepath.Join(dir, "20443.handoff") {
+		t.Fatalf("path %s", path)
+	}
+	return l, path
+}
+
+func TestAHandedOverSocketIsTheClientItselfWithItsBytesUnread(t *testing.T) {
+	l, path := listen(t)
+	client, server := tcpPair(t)
+	defer client.Close()
+	hello := "\x16\x03\x01 hello"
+	if _, err := client.Write([]byte(hello)); err != nil { // sent before the handoff
+		t.Fatal(err)
+	}
+	handOver(t, path, server)
+	conn, err := l.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if _, ok := conn.(*net.TCPConn); !ok {
+		t.Fatalf("accepted %T, want *net.TCPConn", conn)
+	}
+	if conn.RemoteAddr().String() != client.LocalAddr().String() {
+		t.Fatalf("RemoteAddr %v, want the client %v", conn.RemoteAddr(), client.LocalAddr())
+	}
+	conn.SetDeadline(time.Now().Add(5 * time.Second))
+	client.SetDeadline(time.Now().Add(5 * time.Second))
+	got := make([]byte, len(hello))
+	if _, err := io.ReadFull(conn, got); err != nil || string(got) != hello {
+		t.Fatalf("read %q %v", got, err)
+	}
+	if _, err := conn.Write([]byte("answer")); err != nil {
+		t.Fatal(err)
+	}
+	back := make([]byte, 6)
+	if _, err := io.ReadFull(client, back); err != nil || string(back) != "answer" {
+		t.Fatalf("client read %q %v", back, err)
+	}
+}
+
+// Only an inbound on an IPv4 loopback address, with a port, on a node that set the directory, gets one: an
+// unset directory changes nothing, and a public or IPv6 listener is never a dispatcher backend.
+func TestAHandoffListenerIsOnlyBesideAnIPv4LoopbackInboundOfANodeThatAsksForIt(t *testing.T) {
+	t.Setenv(internet.HandoffDirEnv, "")
+	if l, err := internet.ListenHandoffBeside(&net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 20443}); l != nil || err != nil {
+		t.Fatalf("no directory: %v, %v", l, err)
+	}
+	dir := t.TempDir()
+	t.Setenv(internet.HandoffDirEnv, dir)
+	for _, addr := range []*net.TCPAddr{
+		{IP: net.IPv4zero, Port: 20443}, {IP: net.IPv6loopback, Port: 20443}, {IP: net.IPv4(127, 0, 0, 1), Port: 0},
+	} {
+		if l, err := internet.ListenHandoffBeside(addr); l != nil || err != nil {
+			t.Fatalf("%v: %v, %v", addr, l, err)
+		}
+	}
+	if entries, _ := os.ReadDir(dir); len(entries) != 0 {
+		t.Fatalf("files left: %v", entries)
+	}
+}
+
+func TestManyClientsArriveInOrderAndASlowAcceptHoldsTheSender(t *testing.T) {
+	l, path := listen(t)
+	d, err := net.DialUnix("unixpacket", nil, &net.UnixAddr{Name: path, Net: "unixpacket"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer d.Close()
+	var clients []net.Conn
+	sent := make(chan int, 1)
+	go func() {
+		n := 0
+		for i := 0; i < 300; i++ {
+			client, server := tcpPair(t)
+			clients = append(clients, client)
+			f, _ := server.File()
+			if _, _, err := d.WriteMsgUnix([]byte{0}, syscall.UnixRights(int(f.Fd())), nil); err != nil {
+				break
+			}
+			f.Close()
+			server.Close()
+			n++
+		}
+		sent <- n
+	}()
+	time.Sleep(300 * time.Millisecond) // nobody accepts: the backlog fills and the sender waits, nothing is lost
+	for i := 0; i < 300; i++ {
+		conn, err := l.Accept()
+		if err != nil {
+			t.Fatal(err)
+		}
+		conn.Close()
+	}
+	if n := <-sent; n != 300 {
+		t.Fatalf("sent %d", n)
+	}
+	for _, c := range clients {
+		c.Close()
+	}
+}
+
+func TestCloseEndsAcceptAndFreesThePath(t *testing.T) {
+	l, path := listen(t)
+	errc := make(chan error, 1)
+	go func() { _, err := l.Accept(); errc <- err }()
+	time.Sleep(50 * time.Millisecond)
+	l.Close()
+	select {
+	case err := <-errc:
+		if !errors.Is(err, net.ErrClosed) {
+			t.Fatalf("Accept after Close: %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("Accept did not return after Close")
+	}
+	again, err := internet.ListenHandoffBeside(&net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 20443})
+	if err != nil || again == nil {
+		t.Fatalf("listen again on the same path %s: %v", path, err)
+	}
+	again.Close()
+}
+
+func TestAnythingButATCPSocketIsClosedNotAccepted(t *testing.T) {
+	l, path := listen(t)
+	d, err := net.DialUnix("unixpacket", nil, &net.UnixAddr{Name: path, Net: "unixpacket"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer d.Close()
+	r, w, _ := os.Pipe()
+	defer r.Close()
+	defer w.Close()
+	if _, _, err := d.WriteMsgUnix([]byte{0}, syscall.UnixRights(int(r.Fd())), nil); err != nil {
+		t.Fatal(err)
+	}
+	client, server := tcpPair(t)
+	defer client.Close()
+	handOver(t, path, server)
+	conn, err := l.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if conn.RemoteAddr().String() != client.LocalAddr().String() {
+		t.Fatalf("the pipe was accepted, or the TCP client lost: %v", conn.RemoteAddr())
+	}
+}
