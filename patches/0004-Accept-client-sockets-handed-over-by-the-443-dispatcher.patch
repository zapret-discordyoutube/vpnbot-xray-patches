diff --git a/transport/internet/websocket/hub_handoff_linux_test.go b/transport/internet/websocket/hub_handoff_linux_test.go
new file mode 100644
index 0000000..202b164
--- /dev/null
+++ b/transport/internet/websocket/hub_handoff_linux_test.go
@@ -0,0 +1,114 @@
+//go:build linux
+
+package websocket_test
+
+import (
+	"context"
+	gonet "net"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol/tls/cert"
+	"github.com/xtls/xray-core/testing/servers/tcp"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"github.com/xtls/xray-core/transport/internet/tls"
+	. "github.com/xtls/xray-core/transport/internet/websocket"
+)
+
+// A WebSocket+TLS inbound takes a client the 443 dispatcher hands over: the client dials the public port, the
+// dispatcher passes that very socket on, and TLS, the upgrade and the payload all run between the client and
+// the inbound, which sees the client's own address.
+func TestAWebSocketTLSInboundServesAHandedOverClient(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv(internet.HandoffDirEnv, dir)
+	ct, ctHash := cert.MustGenerate(nil, cert.CommonName("localhost"))
+	settings := &internet.MemoryStreamConfig{
+		ProtocolName:     "websocket",
+		ProtocolSettings: &Config{Path: "wss"},
+		SecurityType:     "tls",
+		SecuritySettings: &tls.Config{
+			Certificate:          []*tls.Certificate{tls.ParseCertificate(ct)},
+			PinnedPeerCertSha256: [][]byte{ctHash[:]},
+		},
+	}
+	inboundPort := tcp.PickPort()
+	peers := make(chan gonet.Addr, 1)
+	inbound, err := ListenWS(context.Background(), net.LocalHostIP, inboundPort, settings, func(c stat.Connection) {
+		go func() {
+			defer c.Close()
+			var b [64]byte
+			c.SetReadDeadline(time.Now().Add(5 * time.Second))
+			n, err := c.Read(b[:])
+			if err != nil || string(b[:n]) != "ping" {
+				return
+			}
+			peers <- c.RemoteAddr()
+			c.Write([]byte("pong"))
+		}()
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer inbound.Close()
+
+	public, err := gonet.Listen("tcp", "127.0.0.1:0") // the dispatcher's public port
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer public.Close()
+	publicPort := net.Port(public.Addr().(*gonet.TCPAddr).Port)
+
+	type dialed struct {
+		conn stat.Connection
+		err  error
+	}
+	dial := make(chan dialed, 1)
+	go func() {
+		c, err := Dial(context.Background(), net.TCPDestination(net.DomainAddress("localhost"), publicPort), settings)
+		dial <- dialed{c, err}
+	}()
+	accepted, err := public.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	clientAddr := accepted.RemoteAddr().String()
+	d, err := gonet.DialUnix("unixpacket", nil, &gonet.UnixAddr{Name: internet.HandoffPath(dir, int(inboundPort)), Net: "unixpacket"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	f, err := accepted.(*gonet.TCPConn).File()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := d.WriteMsgUnix([]byte{0}, syscall.UnixRights(int(f.Fd())), nil); err != nil {
+		t.Fatal(err)
+	}
+	f.Close()
+	accepted.Close() // the dispatcher keeps nothing
+	d.Close()
+
+	var r dialed
+	select {
+	case r = <-dial:
+	case <-time.After(10 * time.Second):
+		t.Fatal("the WebSocket+TLS dial through the handed-over socket did not finish")
+	}
+	if r.err != nil {
+		t.Fatalf("dial: %v", r.err)
+	}
+	defer r.conn.Close()
+	r.conn.SetDeadline(time.Now().Add(5 * time.Second))
+	if _, err := r.conn.Write([]byte("ping")); err != nil {
+		t.Fatal(err)
+	}
+	var b [4]byte
+	if _, err := r.conn.Read(b[:]); err != nil || string(b[:]) != "pong" {
+		t.Fatalf("read %q: %v", b, err)
+	}
+	if peer := (<-peers).String(); peer != clientAddr {
+		t.Fatalf("the inbound saw %s, want the client %s", peer, clientAddr)
+	}
+}
