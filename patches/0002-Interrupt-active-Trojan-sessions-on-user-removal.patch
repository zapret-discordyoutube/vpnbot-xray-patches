+package scenarios
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/app/commander"
+	"github.com/xtls/xray-core/app/policy"
+	"github.com/xtls/xray-core/app/proxyman"
+	"github.com/xtls/xray-core/app/proxyman/command"
+	"github.com/xtls/xray-core/app/router"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/serial"
+	core "github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/proxy/dokodemo"
+	"github.com/xtls/xray-core/proxy/freedom"
+	"github.com/xtls/xray-core/proxy/trojan"
+	"github.com/xtls/xray-core/testing/servers/tcp"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials/insecure"
+)
+
+func TestCommanderRemoveTrojanUserInterruptsExactActiveConnection(t *testing.T) {
+	backend := tcp.Server{MsgProcessor: xor}
+	destination, err := backend.Start()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer backend.Close()
+
+	const (
+		userAEmail    = "trojan-a@example.com"
+		userAPassword = "trojan-active-revoke-a"
+		userBEmail    = "trojan-b@example.com"
+		userBPassword = "trojan-active-revoke-b"
+	)
+	serverPort := tcp.PickPort()
+	commandPort := tcp.PickPort()
+	clientAPort := tcp.PickPort()
+	clientBPort := tcp.PickPort()
+
+	serverConfig := &core.Config{
+		App: []*serial.TypedMessage{
+			serial.ToTypedMessage(&commander.Config{
+				Tag: "api",
+				Service: []*serial.TypedMessage{
+					serial.ToTypedMessage(&command.Config{}),
+				},
+			}),
+			serial.ToTypedMessage(&router.Config{
+				Rule: []*router.RoutingRule{{
+					InboundTag: []string{"api"},
+					TargetTag:  &router.RoutingRule_Tag{Tag: "api"},
+				}},
+			}),
+			serial.ToTypedMessage(&policy.Config{
+				Level: map[uint32]*policy.Policy{
+					0: {Timeout: &policy.Policy_Timeout{
+						UplinkOnly:   &policy.Second{Value: 0},
+						DownlinkOnly: &policy.Second{Value: 0},
+					}},
+				},
+			}),
+		},
+		Inbound: []*core.InboundHandlerConfig{
+			{
+				Tag: "trojan",
+				ReceiverSettings: serial.ToTypedMessage(&proxyman.ReceiverConfig{
+					PortList: &net.PortList{Range: []*net.PortRange{net.SinglePortRange(serverPort)}},
+					Listen:   net.NewIPOrDomain(net.LocalHostIP),
+				}),
+				ProxySettings: serial.ToTypedMessage(&trojan.ServerConfig{Users: []*protocol.User{
+					{Email: userAEmail, Account: serial.ToTypedMessage(&trojan.Account{Password: userAPassword})},
+					{Email: userBEmail, Account: serial.ToTypedMessage(&trojan.Account{Password: userBPassword})},
+				}}),
+			},
+			{
+				Tag: "api",
+				ReceiverSettings: serial.ToTypedMessage(&proxyman.ReceiverConfig{
+					PortList: &net.PortList{Range: []*net.PortRange{net.SinglePortRange(commandPort)}},
+					Listen:   net.NewIPOrDomain(net.LocalHostIP),
+				}),
+				ProxySettings: serial.ToTypedMessage(&dokodemo.Config{
+					RewriteAddress:  net.NewIPOrDomain(destination.Address),
+					RewritePort:     uint32(destination.Port),
+					AllowedNetworks: []net.Network{net.Network_TCP},
+				}),
+			},
+		},
+		Outbound: []*core.OutboundHandlerConfig{{
+			ProxySettings: serial.ToTypedMessage(&freedom.Config{
+				FinalRules: []*freedom.FinalRuleConfig{{Action: freedom.RuleAction_Allow}},
+			}),
+		}},
+	}
+
+	clientConfig := func(port net.Port, password string) *core.Config {
+		return &core.Config{
+			Inbound: []*core.InboundHandlerConfig{{
+				ReceiverSettings: serial.ToTypedMessage(&proxyman.ReceiverConfig{
+					PortList: &net.PortList{Range: []*net.PortRange{net.SinglePortRange(port)}},
+					Listen:   net.NewIPOrDomain(net.LocalHostIP),
+				}),
+				ProxySettings: serial.ToTypedMessage(&dokodemo.Config{
+					RewriteAddress:  net.NewIPOrDomain(destination.Address),
+					RewritePort:     uint32(destination.Port),
+					AllowedNetworks: []net.Network{net.Network_TCP},
+				}),
+			}},
+			Outbound: []*core.OutboundHandlerConfig{{
+				ProxySettings: serial.ToTypedMessage(&trojan.ClientConfig{
+					Server: &protocol.ServerEndpoint{
+						Address: net.NewIPOrDomain(net.LocalHostIP),
+						Port:    uint32(serverPort),
+						User: &protocol.User{
+							Account: serial.ToTypedMessage(&trojan.Account{Password: password}),
+						},
+					},
+				}),
+			}},
+		}
+	}
+
+	servers, err := InitializeServerConfigs(
+		serverConfig,
+		clientConfig(clientAPort, userAPassword),
+		clientConfig(clientBPort, userBPassword),
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer CloseAllServers(servers)
+
+	connect := func(port net.Port) (net.Conn, error) {
+		return net.DialTCP("tcp", nil, &net.TCPAddr{
+			IP:   []byte{127, 0, 0, 1},
+			Port: int(port),
+		})
+	}
+	connectionA, err := connect(clientAPort)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connectionA.Close()
+	connectionB, err := connect(clientBPort)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connectionB.Close()
+	if err := testTCPConn2(connectionA, 4096, 3*time.Second)(); err != nil {
+		t.Fatalf("user A did not establish a long-lived Trojan stream: %v", err)
+	}
+	if err := testTCPConn2(connectionB, 4096, 3*time.Second)(); err != nil {
+		t.Fatalf("user B did not establish a long-lived Trojan stream: %v", err)
+	}
+
+	commandConn, err := grpc.Dial(
+		fmt.Sprintf("127.0.0.1:%d", commandPort),
+		grpc.WithTransportCredentials(insecure.NewCredentials()),
+		grpc.WithBlock(),
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer commandConn.Close()
+	handlerClient := command.NewHandlerServiceClient(commandConn)
+	response, err := handlerClient.AlterInbound(context.Background(), &command.AlterInboundRequest{
+		Tag: "trojan",
+		Operation: serial.ToTypedMessage(&command.RemoveUserOperation{
+			Email: userAEmail,
+		}),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if response == nil {
+		t.Fatal("nil Trojan RemoveUser response")
+	}
+
+	if err := testTCPConn2(connectionA, 1024, 3*time.Second)(); err == nil {
+		t.Fatal("removed user's already-authenticated Trojan stream remained usable")
+	}
+	if err := testTCPConn2(connectionB, 4096, 3*time.Second)(); err != nil {
+		t.Fatalf("another user's Trojan stream was interrupted: %v", err)
+	}
+	if err := testTCPConn(clientAPort, 1024, 3*time.Second)(); err == nil {
+		t.Fatal("removed Trojan password established a new stream")
+	}
+	if err := testTCPConn(clientBPort, 4096, 3*time.Second)(); err != nil {
+		t.Fatalf("another Trojan user could not establish a new stream: %v", err)
+	}
+}
