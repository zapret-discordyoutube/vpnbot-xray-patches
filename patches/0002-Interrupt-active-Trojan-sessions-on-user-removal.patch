-# VPnBot exact active VLESS revocation
+# VPnBot exact active VLESS and Trojan revocation
 
 This fork carries one deliberately narrow behavior change for VPnBot-managed
-VLESS users: a successful `HandlerService.RemoveUser` operation both removes
-the UUID from the in-memory validator and interrupts the active transport
-connections authenticated as that exact inbound email.
+VLESS and Trojan users: a successful `HandlerService.RemoveUser` operation both
+removes the credential from the in-memory validator and interrupts the active
+transport connections authenticated as that exact inbound email.
 
 The capability is reported by `xray version` as:
 
 ```text
-VPnBot capability: vpnbot-active-revoke-v1
+VPnBot capability: vpnbot-active-revoke-v2
 ```
 
-VPnBot node installers and updaters must fail closed when this marker is absent.
+The version statement also retains the earlier
+`vpnbot-active-revoke-v1` marker as a backward-compatibility claim for VLESS.
+VPnBot node installers and updaters that require Trojan revocation must fail
+closed when the `v2` marker is absent.
 
-The implementation keeps an active-session registry inside each VLESS inbound
-handler. Registry admission and `AddUser`/`RemoveUser` mutations share one
-mutex, so a connection authenticated before deletion cannot register after the
-same email has been deleted or replaced. `RemoveUser` deletes the validator
-entry before closing its captured sessions, which blocks new handshakes while
-the old sessions are interrupted. A repeated removal remains idempotent and
-retries closing any session whose handler has not yet unwound.
+The implementation uses one shared active-session registry primitive inside
+each VLESS and Trojan inbound handler. Registry admission and
+`AddUser`/`RemoveUser` mutations share one mutex, so a connection authenticated
+before deletion cannot register after the same email has been deleted or
+replaced. `RemoveUser` deletes the validator entry before closing its captured
+sessions, which blocks new handshakes while the old sessions are interrupted.
+A repeated removal remains idempotent and retries closing any session whose
+handler has not yet unwound.
 
 The per-inbound registry prevents one inbound's mutation from touching another
 inbound. The exact email key prevents one user's removal from closing another
 user's active connection.
 
 Regression coverage lives in
-`proxy/vless/inbound/active_sessions_test.go`. Before a VPnBot release, the fork
-must also pass the upstream VLESS scenarios and an external long-stream E2E for
-every transport used by production: TCP, WebSocket, gRPC and XHTTP.
+`common/active_user_sessions_test.go`,
+`proxy/vless/inbound/active_sessions_test.go`, and
+`proxy/trojan/active_sessions_test.go`. Before a VPnBot release, the fork must
+also pass the upstream protocol scenarios and an external long-stream E2E for
+every transport used by production: VLESS TCP, WebSocket, gRPC and XHTTP, plus
+Trojan TCP.
diff --git a/common/active_user_sessions.go b/common/active_user_sessions.go
new file mode 100644
index 00000000..9937b6e3
--- /dev/null
+++ b/common/active_user_sessions.go
@@ -0,0 +1,130 @@
+package common
+
+import (
+	"errors"
+	"strings"
+	"sync"
+)
+
+var (
+	// ErrActiveUserSessionsClosed is returned when a closed inbound is asked to
+	// accept another user or authenticated connection.
+	ErrActiveUserSessionsClosed = errors.New("active user session registry is closed")
+	// ErrActiveUserIdentityChanged is returned when the identity authenticated
+	// by a connection was removed or replaced before registration completed.
+	ErrActiveUserIdentityChanged = errors.New("authenticated user was removed or replaced")
+)
+
+// ActiveUserSessions serializes user mutations with admission of authenticated
+// connections and keeps the connections grouped by their normalized email.
+//
+// A protocol handler must perform AddUser and RemoveUser mutations through this
+// registry and must revalidate the authenticated account in Register. This
+// makes removal a barrier: after Revoke returns, an earlier authentication can
+// no longer join the active set, while every connection admitted before the
+// barrier is included in the returned snapshot.
+type ActiveUserSessions struct {
+	mu            sync.Mutex
+	byEmail       map[string]map[uint64]Closable
+	nextSessionID uint64
+	closed        bool
+}
+
+// NormalizeUserEmail returns the canonical active-session key.
+func NormalizeUserEmail(email string) string {
+	return strings.ToLower(strings.TrimSpace(email))
+}
+
+// MutateIfOpen runs a user addition while holding the same lock used by
+// Register and Revoke.
+func (r *ActiveUserSessions) MutateIfOpen(mutate func() error) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return ErrActiveUserSessionsClosed
+	}
+	return mutate()
+}
+
+// Revoke runs a user removal and atomically snapshots every active connection
+// registered for the same email. Snapshot entries intentionally remain in the
+// registry until their normal unregister callback runs, so a retry can attempt
+// interruption again if the first close reported an error.
+func (r *ActiveUserSessions) Revoke(email string, mutate func(normalizedEmail string) error) ([]Closable, error) {
+	email = NormalizeUserEmail(email)
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	err := mutate(email)
+	return r.sessionsForEmailLocked(email), err
+}
+
+// Register admits one authenticated connection only if stillCurrent confirms,
+// under the mutation lock, that the exact account is still installed.
+func (r *ActiveUserSessions) Register(email string, connection Closable, stillCurrent func(normalizedEmail string) bool) (func(), error) {
+	if connection == nil {
+		return func() {}, nil
+	}
+	email = NormalizeUserEmail(email)
+	if email == "" {
+		return func() {}, nil
+	}
+
+	r.mu.Lock()
+	if r.closed {
+		r.mu.Unlock()
+		return nil, ErrActiveUserSessionsClosed
+	}
+	if !stillCurrent(email) {
+		r.mu.Unlock()
+		return nil, ErrActiveUserIdentityChanged
+	}
+	if r.byEmail == nil {
+		r.byEmail = make(map[string]map[uint64]Closable)
+	}
+	byID := r.byEmail[email]
+	if byID == nil {
+		byID = make(map[uint64]Closable)
+		r.byEmail[email] = byID
+	}
+	r.nextSessionID++
+	sessionID := r.nextSessionID
+	byID[sessionID] = connection
+	r.mu.Unlock()
+
+	return func() {
+		r.mu.Lock()
+		if currentByID := r.byEmail[email]; currentByID != nil {
+			delete(currentByID, sessionID)
+			if len(currentByID) == 0 {
+				delete(r.byEmail, email)
+			}
+		}
+		r.mu.Unlock()
+	}, nil
+}
+
+// Close rejects future mutations and registrations and returns every currently
+// tracked connection for interruption by the protocol handler.
+func (r *ActiveUserSessions) Close() []Closable {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	var sessions []Closable
+	for email := range r.byEmail {
+		sessions = append(sessions, r.sessionsForEmailLocked(email)...)
+	}
+	r.byEmail = nil
+	r.closed = true
+	return sessions
+}
+
+func (r *ActiveUserSessions) sessionsForEmailLocked(email string) []Closable {
+	byID := r.byEmail[email]
+	if len(byID) == 0 {
+		return nil
+	}
+	sessions := make([]Closable, 0, len(byID))
+	for _, connection := range byID {
+		sessions = append(sessions, connection)
+	}
+	return sessions
+}
diff --git a/common/active_user_sessions_test.go b/common/active_user_sessions_test.go
new file mode 100644
index 00000000..e9a83eee
--- /dev/null
+++ b/common/active_user_sessions_test.go
@@ -0,0 +1,57 @@
+package common
+
+import (
+	"errors"
+	"net"
+	"testing"
+)
+
+func TestActiveUserSessionsRevokeIsAdmissionBarrier(t *testing.T) {
+	var installed = "old"
+	var sessions ActiveUserSessions
+	server, client := net.Pipe()
+	defer client.Close()
+	unregister, err := sessions.Register(" User@Example.COM ", server, func(string) bool {
+		return installed == "old"
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unregister()
+
+	connections, err := sessions.Revoke("user@example.com", func(string) error {
+		installed = ""
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(connections) != 1 || connections[0] != server {
+		t.Fatalf("unexpected revoke snapshot: %#v", connections)
+	}
+
+	lateServer, lateClient := net.Pipe()
+	defer lateServer.Close()
+	defer lateClient.Close()
+	if _, err := sessions.Register("user@example.com", lateServer, func(string) bool {
+		return installed == "old"
+	}); !errors.Is(err, ErrActiveUserIdentityChanged) {
+		t.Fatalf("late registration error = %v", err)
+	}
+}
+
+func TestActiveUserSessionsCloseRejectsFurtherUse(t *testing.T) {
+	var sessions ActiveUserSessions
+	if got := sessions.Close(); len(got) != 0 {
+		t.Fatalf("unexpected close snapshot: %#v", got)
+	}
+	if err := sessions.MutateIfOpen(func() error { return nil }); !errors.Is(err, ErrActiveUserSessionsClosed) {
+		t.Fatalf("mutation after close error = %v", err)
+	}
+	server, client := net.Pipe()
+	defer server.Close()
+	defer client.Close()
+	if _, err := sessions.Register("user@example.com", server, func(string) bool { return true }); !errors.Is(err, ErrActiveUserSessionsClosed) {
+		t.Fatalf("registration after close error = %v", err)
+	}
+}
