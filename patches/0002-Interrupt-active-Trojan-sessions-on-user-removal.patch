@@ -0,0 +1,113 @@
+package trojan
+
+import (
+	"context"
+	"io"
+	stdnet "net"
+	"testing"
+
+	"github.com/xtls/xray-core/common/protocol"
+)
+
+func testTrojanMemoryUser(email, password string) *protocol.MemoryUser {
+	account, _ := (&Account{Password: password}).AsAccount()
+	return &protocol.MemoryUser{Email: email, Account: account}
+}
+
+func TestRemoveUserInterruptsOnlyItsActiveTrojanSessions(t *testing.T) {
+	userA := testTrojanMemoryUser("A@example.com", "password-a")
+	userB := testTrojanMemoryUser("b@example.com", "password-b")
+	server := &Server{validator: new(Validator)}
+	if err := server.validator.Add(userA); err != nil {
+		t.Fatal(err)
+	}
+	if err := server.validator.Add(userB); err != nil {
+		t.Fatal(err)
+	}
+
+	serverA, clientA := stdnet.Pipe()
+	defer clientA.Close()
+	unregisterA, err := server.activeSessions.Register(userA.Email, serverA, func(email string) bool {
+		current := server.validator.GetByEmail(email)
+		return current != nil && current.Account.Equals(userA.Account)
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unregisterA()
+
+	serverB, clientB := stdnet.Pipe()
+	defer serverB.Close()
+	defer clientB.Close()
+	go func() { _, _ = io.Copy(io.Discard, serverB) }()
+	unregisterB, err := server.activeSessions.Register(userB.Email, serverB, func(email string) bool {
+		current := server.validator.GetByEmail(email)
+		return current != nil && current.Account.Equals(userB.Account)
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unregisterB()
+
+	if err := server.RemoveUser(context.Background(), "a@EXAMPLE.com"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := clientA.Write([]byte("closed")); err == nil {
+		t.Fatal("removed Trojan user's peer remained writable")
+	}
+	if err := server.RemoveUser(context.Background(), "a@example.com"); err != nil {
+		t.Fatalf("repeated removal must remain idempotent: %v", err)
+	}
+	if _, err := clientB.Write([]byte("still-open")); err != nil {
+		t.Fatalf("another Trojan user's session was interrupted: %v", err)
+	}
+}
+
+func TestTrojanAuthenticationRaceCannotRegisterRemovedIdentity(t *testing.T) {
+	oldUser := testTrojanMemoryUser("same@example.com", "old-password")
+	newUser := testTrojanMemoryUser("same@example.com", "new-password")
+	server := &Server{validator: new(Validator)}
+	if err := server.validator.Add(oldUser); err != nil {
+		t.Fatal(err)
+	}
+	if err := server.RemoveUser(context.Background(), oldUser.Email); err != nil {
+		t.Fatal(err)
+	}
+	if err := server.AddUser(context.Background(), newUser); err != nil {
+		t.Fatal(err)
+	}
+
+	oldServer, oldClient := stdnet.Pipe()
+	defer oldServer.Close()
+	defer oldClient.Close()
+	if _, err := server.activeSessions.Register(oldUser.Email, oldServer, func(email string) bool {
+		current := server.validator.GetByEmail(email)
+		return current != nil && current.Account.Equals(oldUser.Account)
+	}); err == nil {
+		t.Fatal("a connection authenticated with the removed password joined the replacement user's registry")
+	}
+}
+
+func TestTrojanServerCloseInterruptsSessionsAndRejectsLateRegistration(t *testing.T) {
+	user := testTrojanMemoryUser("close@example.com", "close-password")
+	server := &Server{validator: new(Validator)}
+	if err := server.validator.Add(user); err != nil {
+		t.Fatal(err)
+	}
+	serverConn, clientConn := stdnet.Pipe()
+	defer clientConn.Close()
+	unregister, err := server.activeSessions.Register(user.Email, serverConn, func(string) bool { return true })
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unregister()
+	if err := server.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := clientConn.Write([]byte("closed")); err == nil {
+		t.Fatal("server close left an active Trojan session writable")
+	}
+	if err := server.AddUser(context.Background(), testTrojanMemoryUser("late@example.com", "late")); err == nil {
+		t.Fatal("closed Trojan server admitted a late user")
+	}
+}
