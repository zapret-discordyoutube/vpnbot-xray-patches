diff --git a/main/commands/all/api/vpnbot_live_user_audit.go b/main/commands/all/api/vpnbot_live_user_audit.go
new file mode 100644
index 0000000..2b5bd38
--- /dev/null
+++ b/main/commands/all/api/vpnbot_live_user_audit.go
@@ -0,0 +1,161 @@
+package api
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"strings"
+
+	handlerService "github.com/xtls/xray-core/app/proxyman/command"
+	"github.com/xtls/xray-core/common/protocol"
+	creflect "github.com/xtls/xray-core/common/reflect"
+	"github.com/xtls/xray-core/main/commands/base"
+)
+
+const vpnbotLiveUserAuditContract = "vpnbot-live-user-audit-v1"
+
+type vpnbotLiveUserAuditInbound struct {
+	Tag         string           `json:"tag"`
+	UserManager bool             `json:"user_manager"`
+	Users       []*protocol.User `json:"users"`
+	Count       int64            `json:"count"`
+}
+
+type vpnbotLiveUserAuditPass struct {
+	Inbounds []vpnbotLiveUserAuditInbound `json:"inbounds"`
+}
+
+type vpnbotLiveUserAuditResult struct {
+	Contract       string                    `json:"contract"`
+	SnapshotPasses int                       `json:"snapshot_passes"`
+	Passes         []vpnbotLiveUserAuditPass `json:"passes"`
+}
+
+var cmdVPnBotLiveUserAudit = &base.Command{
+	CustomFlags: true,
+	UsageLine:   "{{.Exec}} api vpnbot-audit-users [--server=127.0.0.1:8080]",
+	Short:       "Audit all live inbound users over one gRPC connection",
+	Long: `
+Audit every live inbound user through one gRPC connection.
+
+The command performs two complete passes. Each UserManager list is checked
+against GetInboundUsersCount. The caller must compare the two returned passes.
+
+Arguments:
+
+	-s, -server <server:port>
+		The API server address. Default 127.0.0.1:8080
+
+	-t, -timeout <seconds>
+		Total timeout for both audit passes. Default 3
+`,
+	Run: executeVPnBotLiveUserAudit,
+}
+
+func executeVPnBotLiveUserAudit(cmd *base.Command, args []string) {
+	setSharedFlags(cmd)
+	cmd.Flag.Parse(args)
+	if len(cmd.Flag.Args()) != 0 {
+		base.Fatalf("vpnbot live user audit accepts no positional arguments")
+	}
+
+	conn, ctx, close := dialAPIServer()
+	defer close()
+	result, err := collectVPnBotLiveUserAudit(
+		ctx,
+		handlerService.NewHandlerServiceClient(conn),
+	)
+	if err != nil {
+		base.Fatalf("vpnbot live user audit failed: %s", err)
+	}
+	payload, ok := creflect.MarshalToJson(result, true)
+	if !ok {
+		base.Fatalf("vpnbot live user audit response encoding failed")
+	}
+	fmt.Println(payload)
+}
+
+func collectVPnBotLiveUserAudit(
+	ctx context.Context,
+	client handlerService.HandlerServiceClient,
+) (*vpnbotLiveUserAuditResult, error) {
+	passes := make([]vpnbotLiveUserAuditPass, 0, 2)
+	for passNumber := 0; passNumber < 2; passNumber++ {
+		pass, err := collectVPnBotLiveUserAuditPass(ctx, client)
+		if err != nil {
+			return nil, fmt.Errorf("pass %d: %w", passNumber+1, err)
+		}
+		passes = append(passes, pass)
+	}
+	return &vpnbotLiveUserAuditResult{
+		Contract:       vpnbotLiveUserAuditContract,
+		SnapshotPasses: len(passes),
+		Passes:         passes,
+	}, nil
+}
+
+func collectVPnBotLiveUserAuditPass(
+	ctx context.Context,
+	client handlerService.HandlerServiceClient,
+) (vpnbotLiveUserAuditPass, error) {
+	listed, err := client.ListInbounds(
+		ctx,
+		&handlerService.ListInboundsRequest{IsOnlyTags: true},
+	)
+	if err != nil {
+		return vpnbotLiveUserAuditPass{}, fmt.Errorf("list inbounds: %w", err)
+	}
+	tags := make([]string, 0, len(listed.GetInbounds()))
+	seen := make(map[string]struct{}, len(listed.GetInbounds()))
+	for _, inbound := range listed.GetInbounds() {
+		tag := strings.TrimSpace(inbound.GetTag())
+		if tag == "" {
+			return vpnbotLiveUserAuditPass{}, fmt.Errorf("live inbound has an empty tag")
+		}
+		if _, exists := seen[tag]; exists {
+			return vpnbotLiveUserAuditPass{}, fmt.Errorf("live inbound tag is duplicated")
+		}
+		seen[tag] = struct{}{}
+		tags = append(tags, tag)
+	}
+	sort.Strings(tags)
+
+	inbounds := make([]vpnbotLiveUserAuditInbound, 0, len(tags))
+	for _, tag := range tags {
+		request := &handlerService.GetInboundUserRequest{Tag: tag}
+		usersResponse, usersErr := client.GetInboundUsers(ctx, request)
+		if usersErr != nil {
+			message := strings.ToLower(usersErr.Error())
+			if strings.Contains(message, "not a usermanager") ||
+				strings.Contains(message, "not a user manager") {
+				inbounds = append(inbounds, vpnbotLiveUserAuditInbound{
+					Tag:         tag,
+					UserManager: false,
+					Users:       make([]*protocol.User, 0),
+					Count:       0,
+				})
+				continue
+			}
+			return vpnbotLiveUserAuditPass{}, fmt.Errorf("get inbound users: %w", usersErr)
+		}
+		users := usersResponse.GetUsers()
+		if users == nil {
+			users = make([]*protocol.User, 0)
+		}
+		countResponse, countErr := client.GetInboundUsersCount(ctx, request)
+		if countErr != nil {
+			return vpnbotLiveUserAuditPass{}, fmt.Errorf("get inbound user count: %w", countErr)
+		}
+		count := countResponse.GetCount()
+		if count < 0 || count != int64(len(users)) {
+			return vpnbotLiveUserAuditPass{}, fmt.Errorf("inbound user list changed during pass")
+		}
+		inbounds = append(inbounds, vpnbotLiveUserAuditInbound{
+			Tag:         tag,
+			UserManager: true,
+			Users:       users,
+			Count:       count,
+		})
+	}
+	return vpnbotLiveUserAuditPass{Inbounds: inbounds}, nil
+}
diff --git a/main/commands/all/api/vpnbot_live_user_audit_test.go b/main/commands/all/api/vpnbot_live_user_audit_test.go
new file mode 100644
