@@ -0,0 +1,123 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	handlerService "github.com/xtls/xray-core/app/proxyman/command"
+	"github.com/xtls/xray-core/common/protocol"
+	creflect "github.com/xtls/xray-core/common/reflect"
+	"github.com/xtls/xray-core/common/serial"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/proxy/vless"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+type vpnbotLiveUserAuditFakeClient struct {
+	handlerService.HandlerServiceClient
+	t          *testing.T
+	listCalls  int
+	userCalls  int
+	countCalls int
+}
+
+func (f *vpnbotLiveUserAuditFakeClient) ListInbounds(
+	context.Context,
+	*handlerService.ListInboundsRequest,
+	...grpc.CallOption,
+) (*handlerService.ListInboundsResponse, error) {
+	f.listCalls++
+	return &handlerService.ListInboundsResponse{Inbounds: []*core.InboundHandlerConfig{
+		{Tag: "vless-live"},
+		{Tag: "api"},
+	}}, nil
+}
+
+func (f *vpnbotLiveUserAuditFakeClient) GetInboundUsers(
+	_ context.Context,
+	request *handlerService.GetInboundUserRequest,
+	_ ...grpc.CallOption,
+) (*handlerService.GetInboundUserResponse, error) {
+	f.userCalls++
+	if request.GetTag() == "api" {
+		return nil, status.Error(codes.Unknown, "proxy is not a UserManager")
+	}
+	return &handlerService.GetInboundUserResponse{Users: []*protocol.User{
+		{
+			Level:   0,
+			Email:   "audit@example.invalid",
+			Account: serial.ToTypedMessage(&vless.Account{Id: "audit-user-id"}),
+		},
+	}}, nil
+}
+
+func (f *vpnbotLiveUserAuditFakeClient) GetInboundUsersCount(
+	_ context.Context,
+	request *handlerService.GetInboundUserRequest,
+	_ ...grpc.CallOption,
+) (*handlerService.GetInboundUsersCountResponse, error) {
+	f.countCalls++
+	if request.GetTag() != "vless-live" {
+		f.t.Fatalf("unexpected count request for %q", request.GetTag())
+	}
+	return &handlerService.GetInboundUsersCountResponse{Count: 1}, nil
+}
+
+func TestCollectVPnBotLiveUserAuditUsesTwoCompletePasses(t *testing.T) {
+	client := &vpnbotLiveUserAuditFakeClient{t: t}
+	result, err := collectVPnBotLiveUserAudit(context.Background(), client)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Contract != vpnbotLiveUserAuditContract || result.SnapshotPasses != 2 {
+		t.Fatalf("unexpected result contract: %#v", result)
+	}
+	if len(result.Passes) != 2 || client.listCalls != 2 || client.userCalls != 4 || client.countCalls != 2 {
+		t.Fatalf("unexpected audit call counts: result=%#v client=%#v", result, client)
+	}
+	for _, pass := range result.Passes {
+		if len(pass.Inbounds) != 2 {
+			t.Fatalf("unexpected inbound count: %#v", pass)
+		}
+		if pass.Inbounds[0].Tag != "api" || pass.Inbounds[0].UserManager {
+			t.Fatalf("non-UserManager inbound was not preserved: %#v", pass.Inbounds[0])
+		}
+		if pass.Inbounds[1].Tag != "vless-live" || !pass.Inbounds[1].UserManager || pass.Inbounds[1].Count != 1 {
+			t.Fatalf("UserManager inbound was not audited: %#v", pass.Inbounds[1])
+		}
+	}
+}
+
+func TestVPnBotLiveUserAuditJSONPreservesTypedAccounts(t *testing.T) {
+	client := &vpnbotLiveUserAuditFakeClient{t: t}
+	result, err := collectVPnBotLiveUserAudit(context.Background(), client)
+	if err != nil {
+		t.Fatal(err)
+	}
+	payload, ok := creflect.MarshalToJson(result, true)
+	if !ok {
+		t.Fatal("live user audit result did not marshal")
+	}
+	var decoded map[string]interface{}
+	if err := json.Unmarshal([]byte(payload), &decoded); err != nil {
+		t.Fatal(err)
+	}
+	passes, ok := decoded["passes"].([]interface{})
+	if !ok || len(passes) != 2 {
+		t.Fatalf("unexpected JSON passes: %#v", decoded["passes"])
+	}
+	for _, rawPass := range passes {
+		pass := rawPass.(map[string]interface{})
+		inbounds := pass["inbounds"].([]interface{})
+		live := inbounds[1].(map[string]interface{})
+		users := live["users"].([]interface{})
+		user := users[0].(map[string]interface{})
+		account := user["account"].(map[string]interface{})
+		if account["_TypedMessage_"] != "xray.proxy.vless.Account" || account["id"] != "audit-user-id" {
+			t.Fatalf("typed VLESS account was not preserved: %#v", account)
+		}
+	}
+}
