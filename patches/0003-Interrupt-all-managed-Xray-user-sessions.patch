@@ -0,0 +1,71 @@
+package shadowsocks
+
+import (
+	"context"
+	"io"
+	stdnet "net"
+	"testing"
+
+	"github.com/xtls/xray-core/common/protocol"
+)
+
+func testShadowsocksMemoryUser(t *testing.T, email, password string) *protocol.MemoryUser {
+	t.Helper()
+	account, err := (&Account{
+		Password:   password,
+		CipherType: CipherType_CHACHA20_POLY1305,
+	}).AsAccount()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &protocol.MemoryUser{Email: email, Account: account}
+}
+
+func TestRemoveUserInterruptsOnlyItsActiveShadowsocksSessions(t *testing.T) {
+	userA := testShadowsocksMemoryUser(t, "A@example.com", "password-a")
+	userB := testShadowsocksMemoryUser(t, "b@example.com", "password-b")
+	server := &Server{validator: new(Validator)}
+	if err := server.AddUser(context.Background(), userA); err != nil {
+		t.Fatal(err)
+	}
+	if err := server.AddUser(context.Background(), userB); err != nil {
+		t.Fatal(err)
+	}
+
+	serverA, clientA := stdnet.Pipe()
+	defer clientA.Close()
+	unregisterA, err := server.activeSessions.Register(userA.Email, serverA, func(email string) bool {
+		current := server.validator.GetByEmail(email)
+		return current != nil && current.Account.Equals(userA.Account)
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unregisterA()
+
+	serverB, clientB := stdnet.Pipe()
+	defer serverB.Close()
+	defer clientB.Close()
+	go func() { _, _ = io.Copy(io.Discard, serverB) }()
+	unregisterB, err := server.activeSessions.Register(userB.Email, serverB, func(email string) bool {
+		current := server.validator.GetByEmail(email)
+		return current != nil && current.Account.Equals(userB.Account)
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unregisterB()
+
+	if err := server.RemoveUser(context.Background(), "a@EXAMPLE.com"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := clientA.Write([]byte("closed")); err == nil {
+		t.Fatal("removed Shadowsocks user's peer remained writable")
+	}
+	if err := server.RemoveUser(context.Background(), "a@example.com"); err != nil {
+		t.Fatalf("repeated removal must remain idempotent: %v", err)
+	}
+	if _, err := clientB.Write([]byte("still-open")); err != nil {
+		t.Fatalf("another Shadowsocks user's session was interrupted: %v", err)
+	}
+}
