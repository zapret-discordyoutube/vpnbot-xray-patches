+package inbound
+
+import (
+	"context"
+	"io"
+	stdnet "net"
+	"testing"
+
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/uuid"
+	"github.com/xtls/xray-core/proxy/vmess"
+	"github.com/xtls/xray-core/proxy/vmess/encoding"
+)
+
+func testVMessMemoryUser(t *testing.T, email, rawID string) *protocol.MemoryUser {
+	t.Helper()
+	account, err := (&vmess.Account{Id: rawID}).AsAccount()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &protocol.MemoryUser{Email: email, Account: account}
+}
+
+func testVMessHandler() *Handler {
+	return &Handler{
+		clients:        vmess.NewTimedUserValidator(),
+		usersByEmail:   newUserByEmail(&DefaultConfig{}),
+		sessionHistory: encoding.NewSessionHistory(),
+	}
+}
+
+func TestRemoveUserInterruptsOnlyItsActiveVMessSessions(t *testing.T) {
+	userA := testVMessMemoryUser(t, "A@example.com", protocol.NewID(uuid.New()).String())
+	userB := testVMessMemoryUser(t, "b@example.com", protocol.NewID(uuid.New()).String())
+	handler := testVMessHandler()
+	defer handler.sessionHistory.Close()
+	if err := handler.AddUser(context.Background(), userA); err != nil {
+		t.Fatal(err)
+	}
+	if err := handler.AddUser(context.Background(), userB); err != nil {
+		t.Fatal(err)
+	}
+
+	serverA, clientA := stdnet.Pipe()
+	defer clientA.Close()
+	unregisterA, err := handler.activeSessions.Register(userA.Email, serverA, func(email string) bool {
+		current := handler.usersByEmail.Get(email)
+		return current != nil && current.Account.Equals(userA.Account)
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unregisterA()
+
+	serverB, clientB := stdnet.Pipe()
+	defer serverB.Close()
+	defer clientB.Close()
+	go func() { _, _ = io.Copy(io.Discard, serverB) }()
+	unregisterB, err := handler.activeSessions.Register(userB.Email, serverB, func(email string) bool {
+		current := handler.usersByEmail.Get(email)
+		return current != nil && current.Account.Equals(userB.Account)
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unregisterB()
+
+	if err := handler.RemoveUser(context.Background(), "a@EXAMPLE.com"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := clientA.Write([]byte("closed")); err == nil {
+		t.Fatal("removed VMess user's peer remained writable")
+	}
+	if err := handler.RemoveUser(context.Background(), "a@example.com"); err != nil {
+		t.Fatalf("repeated removal must remain idempotent: %v", err)
+	}
+	if _, err := clientB.Write([]byte("still-open")); err != nil {
+		t.Fatalf("another VMess user's session was interrupted: %v", err)
+	}
+}
